<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="#161616" android:padding="16dp">

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="📂 ملفات .nam" android:textColor="#FFF"
        android:textSize="16sp" android:textStyle="bold" android:layout_marginBottom="12dp"/>

    <TextView android:id="@+id/tvNamEmpty" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="لا توجد ملفات .nam على الجهاز"
        android:textColor="#666" android:gravity="center" android:padding="16dp"
        android:visibility="gone"/>

    <ScrollView android:layout_width="match_parent" android:layout_height="200dp"
        android:layout_marginBottom="12dp">
        <LinearLayout android:id="@+id/llNamFiles" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"/>
    </ScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button android:id="@+id/btnRescan" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="44dp" android:layout_marginEnd="8dp"
            android:text="🔄 مسح" android:backgroundTint="#333" android:textColor="#EEE"/>
        <Button android:id="@+id/btnBrowseNam" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="44dp" android:text="📂 تصفح"
            android:backgroundTint="#FF9800" android:textColor="#000" android:textStyle="bold"/>
    </LinearLayout>
</LinearLayout>
